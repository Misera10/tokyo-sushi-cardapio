<Application x:Class="TokyoSushi.PrintAgent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#16232D" />
        <SolidColorBrush x:Key="InkMutedBrush" Color="#78909C" />
        <SolidColorBrush x:Key="PaperBrush" Color="#F8F7F3" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E2E7E8" />
        <SolidColorBrush x:Key="GoldBrush" Color="#C79B4B" />
        <SolidColorBrush x:Key="GreenBrush" Color="#16796F" />
        <SolidColorBrush x:Key="RedBrush" Color="#B85160" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
