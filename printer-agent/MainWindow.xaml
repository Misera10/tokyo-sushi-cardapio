<Window x:Class="TokyoSushi.PrintAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tokyo Print · Tokyo Sushi"
        Height="720" Width="1040" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PaperBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource InkBrush}">
            <Grid Margin="20,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="TOKYO / PRINT" Foreground="{StaticResource GoldBrush}" FontSize="12" FontWeight="Bold" />
                    <TextBlock Text="Impressão local" Foreground="White" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock Text="Pedidos do Admin direto para a impressora." Foreground="#AFC1C8" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Border Background="#243640" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="STATUS DO AGENTE" Foreground="#AFC1C8" FontSize="10" FontWeight="Bold" />
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Ellipse Width="9" Height="9" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="AgentStatusText" Text="Conectado" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="NAVEGAÇÃO" Foreground="#78909C" FontSize="10" FontWeight="Bold" Margin="3,18,0,12" />
                    <Button Content="Visão geral" Click="NavigateOverview_Click" HorizontalContentAlignment="Left" Background="#2D424D" Foreground="White" Padding="13,11" Margin="0" />
                    <Button Content="Impressoras" Click="NavigatePrinters_Click" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C7D3D7" Padding="13,11" Margin="0,8,0,0" />
                    <Button Content="Fila de impressão" Click="NavigateQueue_Click" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C7D3D7" Padding="13,11" Margin="0,8,0,0" />
                    <Button Content="Configurações" Click="NavigateSettings_Click" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C7D3D7" Padding="13,11" Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Tokyo Sushi" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Text="Tokyo Print v0.3.17 · Windows" Foreground="#78909C" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,30,28,36">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Impressão local" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="Impressora, teste e fila em um só lugar." Foreground="{StaticResource InkMutedBrush}" FontSize="14" Margin="0,6,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="Atualizar impressoras" Click="RefreshButton_Click" Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                </DockPanel>

                <Grid Margin="0,30,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="IMPRESSORAS" Foreground="{StaticResource InkMutedBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="PrinterCountText" Text="0" FontSize="25" FontWeight="SemiBold" Margin="0,9,0,0" />
                            <TextBlock Text="reconhecidas pelo Windows" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="5,0,5,0">
                        <StackPanel>
                            <TextBlock Text="PADRÃO DO WINDOWS" Foreground="{StaticResource InkMutedBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="SelectedPrinterText" Text="Nenhuma" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,12,0,0" />
                            <TextBlock Text="detectada diretamente no spooler do Windows" Foreground="{StaticResource InkMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#E7F2EF" BorderBrush="#C7E1DB" BorderThickness="1" CornerRadius="14" Padding="18" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="ÚLTIMO TESTE" Foreground="{StaticResource GreenBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="LastTestText" Text="Ainda não testado" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
                            <TextBlock Text="pronto para validar" Foreground="{StaticResource GreenBrush}" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.8*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,12,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Impressoras disponíveis" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Text="Escolha onde as comandas da Tokyo serão enviadas." Foreground="{StaticResource InkMutedBrush}" FontSize="12" Margin="0,5,0,0" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" Text="SPOOLER" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                            </DockPanel>
                            <DataGrid x:Name="PrintersGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None" RowHeight="46" Margin="0,18,0,0" SelectionChanged="PrintersGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="NOME DA IMPRESSORA" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="PORTA" Binding="{Binding Port}" Width="130" />
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="PrinterEmptyText" Text="Nenhuma impressora encontrada no Windows." Foreground="{StaticResource InkMutedBrush}" Visibility="Collapsed" Margin="0,20,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Teste rápido" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="Confirme a impressora antes de ligar a impressão automática no Admin." Foreground="{StaticResource InkMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,18" />
                                <TextBlock Text="TESTE COM AS CONFIGURAÇÕES SALVAS" Foreground="{StaticResource InkMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="Usa papel, fonte e margens definidos em Configurações." Foreground="{StaticResource InkMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,16" />
                                <Button x:Name="TestPrintButton" Content="Imprimir comanda de teste" Click="TestPrintButton_Click" Background="{StaticResource GreenBrush}" Foreground="White" HorizontalContentAlignment="Center" Padding="12" />
                                <TextBlock x:Name="TestStatusText" Text="Selecione uma impressora para começar." Foreground="{StaticResource InkMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border x:Name="QueueSection" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,28,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Fila local" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="Acompanhe cada comanda e tente novamente quando uma impressora falhar." Foreground="{StaticResource InkMutedBrush}" FontSize="12" Margin="0,5,0,0" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="ÚLTIMOS 30 TRABALHOS" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid x:Name="JobsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None" RowHeight="42" Margin="0,18,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PEDIDO" Binding="{Binding OrderId}" Width="140" />
                                <DataGridTextColumn Header="IMPRESSORA" Binding="{Binding PrinterName}" Width="*" />
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110" />
                                <DataGridTextColumn Header="DATA" Binding="{Binding CreatedAt, StringFormat=dd/MM HH:mm}" Width="110" />
                                <DataGridTemplateColumn Header="AÇÃO" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Tentar de novo" Tag="{Binding Id}" Click="RetryJobButton_Click" Padding="8,5" Margin="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="JobsEmptyText" Text="Nenhum trabalho de impressão ainda." Foreground="{StaticResource InkMutedBrush}" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="SettingsSection" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,28,0,0">
                    <StackPanel>
                        <TextBlock Text="Configurações do agente" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Salvas neste notebook e usadas no teste e nas impressões automáticas." Foreground="{StaticResource InkMutedBrush}" FontSize="12" Margin="0,5,0,18" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.95*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="IMPRESSORA PADRÃO DO AGENTE" Foreground="{StaticResource InkMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <ComboBox x:Name="SettingsPrinterCombo" Margin="0,8,0,0" SelectionChanged="SettingsPrinterCombo_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                <TextBlock Text="PAPEL E FONTE" Foreground="{StaticResource InkMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <ComboBox x:Name="SettingsPaperWidthCombo" Margin="0,8,0,0" SelectedIndex="1">
                                    <ComboBoxItem Content="58 mm · compacta" Tag="58" />
                                    <ComboBoxItem Content="80 mm · padrão" Tag="80" />
                                </ComboBox>
                                <TextBlock Text="TAMANHO DA FONTE (6–14)" Foreground="{StaticResource InkMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,14,0,0" />
                                <TextBox x:Name="SettingsFontSizeText" Text="9" Margin="0,8,0,0" Padding="8" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,6,0">
                                <TextBlock Text="MARGENS (MM)" Foreground="{StaticResource InkMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Esquerda" Foreground="{StaticResource InkMutedBrush}" FontSize="10" /><TextBox x:Name="SettingsMarginLeftText" Text="3" Margin="0,4,0,7" Padding="8" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Direita" Foreground="{StaticResource InkMutedBrush}" FontSize="10" /><TextBox x:Name="SettingsMarginRightText" Text="3" Margin="0,4,0,7" Padding="8" /></StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Superior" Foreground="{StaticResource InkMutedBrush}" FontSize="10" /><TextBox x:Name="SettingsMarginTopText" Text="3" Margin="0,4,0,0" Padding="8" /></StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Inferior" Foreground="{StaticResource InkMutedBrush}" FontSize="10" /><TextBox x:Name="SettingsMarginBottomText" Text="3" Margin="0,4,0,0" Padding="8" /></StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="12,0,0,0">
                                <TextBlock Text="INICIALIZAÇÃO" Foreground="{StaticResource InkMutedBrush}" FontSize="10" FontWeight="Bold" />
                                <CheckBox x:Name="StartWithWindowsCheck" Content="Iniciar com o Windows" Margin="0,10,0,0" />
                                <CheckBox x:Name="StartMinimizedCheck" Content="Iniciar minimizado" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0" VerticalAlignment="Center">
                            <Button x:Name="SaveSettingsButton" Content="Salvar configurações" Click="SaveSettingsButton_Click" Background="{StaticResource GreenBrush}" Foreground="White" BorderBrush="#0E5F56" BorderThickness="1" FontWeight="Bold" Padding="14,10" MinWidth="190" />
                            <TextBlock x:Name="SettingsStatusText" Text="" Visibility="Collapsed" Foreground="{StaticResource InkMutedBrush}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
